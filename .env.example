# =============================================================================
# MediaOS Environment Variables
# Copy this file to .env.local and fill in your Supabase project values.
# Never commit .env.local or secrets to version control.
# =============================================================================

# Public Supabase URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon / publishable key (safe for browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Application metadata
NEXT_PUBLIC_APP_NAME=MediaOS
NEXT_PUBLIC_APP_URL=http://localhost:3003

# =============================================================================
# AI Orchestrator (Feature 005 / Module 2.1) — server-only secrets
# Never prefix these with NEXT_PUBLIC_. Never expose to the browser.
# =============================================================================

# Default provider + timeout (used when org settings are fresh)
DEFAULT_AI_PROVIDER=gemini
DEFAULT_GEMINI_MODEL=gemini-3.5-flash
# Image generation (Sub Headline AI image, etc.) — paid Gemini image model
# Free-tier keys return 429 / quota 0. Enable billing on the Google AI project.
DEFAULT_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
AI_REQUEST_TIMEOUT=60000

# OpenAI
OPENAI_API_KEY=

# Google Gemini — preferred: GOOGLE_API_KEY (also accepts GEMINI_API_KEY / GOOGLE_AI_API_KEY)
GOOGLE_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Ollama local / remote base URL (e.g. http://127.0.0.1:11434)
OLLAMA_BASE_URL=

# =============================================================================
# Google Cloud Text-to-Speech (Production Pipeline Step 1)
# Server-only. Never prefix with NEXT_PUBLIC_.
# =============================================================================

# Preferred: paste the full service-account JSON as a single-line string
GOOGLE_CLOUD_TTS_CREDENTIALS=

# Or: absolute path to a service-account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Optional GCP project id (usually embedded in the JSON)
GOOGLE_CLOUD_PROJECT=

# Gemini TTS model (uses GOOGLE_API_KEY / GEMINI_API_KEY above)
# Default: gemini-2.5-flash-preview-tts
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# =============================================================================
# Web media search (Sub Headline Find image/video) — server-only
# At least one provider required. Pexels + YouTube (via GOOGLE_API_KEY) recommended.
# =============================================================================

# https://www.pexels.com/api/ — stock images + videos
PEXELS_API_KEY=

# https://unsplash.com/developers — stock images
UNSPLASH_ACCESS_KEY=

# YouTube Data API v3 — uses GOOGLE_API_KEY above unless overridden.
# Enable "YouTube Data API v3" in Google Cloud Console for the same project.
# YOUTUBE_DATA_API_KEY=

# Google Programmable Search — images + Facebook/YouTube web results
# Create a CSE at https://programmablesearchengine.google.com/ (Search the entire web)
# GOOGLE_CSE_API_KEY=  # falls back to GOOGLE_API_KEY if unset
GOOGLE_CSE_CX=

# =============================================================================
# Video Rendering & Export — provider selection (server-only)
# Never prefix with NEXT_PUBLIC_. Restart `npm run dev` after changing.
# =============================================================================

# local = Local FFmpeg   |   cloud = RenderOS service
RENDER_PROVIDER=local

# Absolute paths recommended on Windows, e.g. C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# RenderOS base URL (used only when RENDER_PROVIDER=cloud)
# Example: http://127.0.0.1:8090
RENDER_API=
