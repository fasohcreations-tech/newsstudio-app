{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mediaos.local/schemas/story-data-form/v1.0",
  "title": "StoryDataRecord",
  "description": "Module 3.5 flat story schema for live preview binding and future AI population.",
  "type": "object",
  "required": ["headline", "story_id"],
  "properties": {
    "headline": { "type": "string" },
    "subheadline": { "type": "string" },
    "summary": { "type": "string" },
    "sub_headline_1": { "type": "string" },
    "sub_headline_2": { "type": "string" },
    "sub_headline_3": { "type": "string" },
    "sub_headline_4": { "type": "string" },
    "category": { "type": "string" },
    "tags": { "type": "string" },
    "priority": { "type": "string" },
    "breaking_news": { "type": "boolean" },
    "live": { "type": "boolean" },
    "reporter_name": { "type": "string" },
    "reporter_photo": { "type": "string", "format": "uri" },
    "designation": { "type": "string" },
    "location": { "type": "string" },
    "organization": { "type": "string" },
    "place": { "type": "string" },
    "date": { "type": "string" },
    "time": { "type": "string" },
    "story_id": { "type": "string" },
    "main_video": { "type": "string" },
    "secondary_video": { "type": "string" },
    "main_image": { "type": "string" },
    "gallery_images": { "type": "string" },
    "optional_info_image": { "type": "string" },
    "optional_info_image_3": { "type": "string" },
    "optional_info_transition_style": { "type": "string" },
    "optional_info_slide_interval_ms": { "type": "string" },
    "optional_info_transition_ms": { "type": "string" },
    "optional_info_slide_index": { "type": "string" },
    "optional_info_text": { "type": "string" },
    "optional_info_text_3": { "type": "string" },
    "background_video": { "type": "string" },
    "background_image": { "type": "string" },
    "logo": { "type": "string" },
    "watermark": { "type": "string" },
    "voice_over": { "type": "string" },
    "background_music": { "type": "string" },
    "sound_fx": { "type": "string" },
    "quote": { "type": "string" },
    "bible_verse": { "type": "string" },
    "verse_reference": { "type": "string" },
    "ticker": { "type": "string" },
    "call_to_action": { "type": "string" },
    "website": { "type": "string" },
    "social_links": { "type": "string" },
    "theme": { "type": "string" },
    "primary_color": { "type": "string" },
    "secondary_color": { "type": "string" },
    "accent_color": { "type": "string" },
    "animation_preset": { "type": "string" },
    "font_family": { "type": "string" }
  },
  "additionalProperties": false
}
